# 复制本文件为 .env 并填入你自己的端点信息（.env 已在 .gitignore 中，不会入库）
# 任何 OpenAI 兼容端点都可以：DeepSeek / 阿里百炼 / 火山方舟 / 本地 vLLM / Ollama…

# 示例 1：DeepSeek 官方（支持 function calling）
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-你的key
MODEL=deepseek-chat

# 示例 2：本地 Ollama（OpenAI 兼容模式，模型需支持工具调用，如 qwen2.5:7b）
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# MODEL=qwen2.5:7b

# 示例 3：本地 vLLM（需以 --enable-auto-tool-choice 启动才支持工具调用）
# OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_API_KEY=EMPTY
# MODEL=Qwen2.5-7B-Instruct
